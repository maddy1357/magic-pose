# Copy this file to .env and fill in what you need.

# Port for the web server
PORT=3000

# --- AI templates -------------------------------------------------------
# AI provider for the Template mode: "openai", "mock" (returns your photo
# unchanged, for testing) or "none". Defaults to "openai" when a key is set.
# AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# Image model used for edits
AI_IMAGE_MODEL=gpt-image-1
# low | medium | high  (higher = slower, better)
AI_IMAGE_QUALITY=medium
# "high" keeps faces closer to the original photo; leave empty to omit
AI_INPUT_FIDELITY=high
AI_TIMEOUT_MS=120000

# --- HTTPS (needed to use the camera from a phone on your network) -----
# HTTPS_KEY=certs/key.pem
# HTTPS_CERT=certs/cert.pem
